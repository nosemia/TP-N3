#include <iostream>
using namespace std;

int main() {
    int opcion;
    do {
        cout << "\nMenu:\n";
        cout << "2. Suma, maximo, minimo y promedio\n";
        cout << "3. Division por 2 hasta <0.01\n";
        cout << "4. Serie 11, 22, 33...\n";
        cout << "5. Contar pares e impares\n";
        cout << "6. Sumatoria de pares 1 a 100\n";
        cout << "7. Contar y sumar impares hasta 300\n";
        cout << "8. Calcular quinta potencia\n";
        cout << "0. Salir\n";
        cout << "Opcion: ";
        cin >> opcion;

        switch (opcion) {
            case 2: {
                double num, suma = 0, maximo, minimo;
                cout << "Ingrese 10 numeros:\n";
                cin >> num;
                suma = maximo = minimo = num;
                for (int i = 1; i < 10; i++) {
                    cin >> num;
                    suma += num;
                    if (num > maximo) maximo = num;
                    if (num < minimo) minimo = num;
                }
                cout << "Suma: " << suma << endl;
                cout << "Maximo: " << maximo << endl;
                cout << "Minimo: " << minimo << endl;
                cout << "Promedio: " << suma / 10 << endl;
                break;
            }
            case 3: {
                double n;
                cout << "Ingrese un numero: ";
                cin >> n;
                while (n >= 0.01) {
                    cout << n << endl;
                    n /= 2;
                }
                break;
            }
            case 4: {
                for (int i = 1; i <= 25; i++)
                    cout << i * 11 << " ";
                cout << endl;
                break;
            }
            case 5: {
                int n, valor, pares = 0, impares = 0;
                cout << "Cantidad de numeros: ";
                cin >> n;
                for (int i = 0; i < n; i++) {
                    cin >> valor;
                    if (valor % 2 == 0) pares++;
                    else impares++;
                }
                cout << "Pares: " << pares << endl;
                cout << "Impares: " << impares << endl;
                break;
            }
            case 6: {
                int suma = 0;
                for (int i = 2; i <= 100; i += 2) {
                    cout << i << " ";
                    suma += i;
                }
                cout << "\nSuma total: " << suma << endl;
                break;
            }
            case 7: {
                int suma = 0, contador = 0;
                for (int i = 1; i <= 300; i += 2) {
                    contador++;
                    suma += i;
                }
                cout << "Cantidad de impares: " << contador << endl;
                cout << "Suma de impares: " << suma << endl;
                break;
            }
            case 8: {
                int x, resultado = 1;
                cout << "Ingrese un numero: ";
                cin >> x;
                for (int i = 0; i < 5; i++)
                    resultado *= x;
                cout << x << "^5 = " << resultado << endl;
                break;
            }
            case 0:
                cout << "Fin del programa.\n";
                break;
            default:
                cout << "Opcion invalida.\n";
        }
    } while (opcion != 0);

    return 0;
}

